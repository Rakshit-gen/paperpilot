GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
DATA_DIR=./data
UPLOAD_DIR=./uploads
DB_PATH=./paperpilot.db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CORS_ORIGIN=http://localhost:3000
# random secret used to sign login tokens, generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
# leave unset for local dev (falls back to an in-memory vector store)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=paperpilot
